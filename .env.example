# Agent 模块的环境变量（docs/agent-plan.md 第 3、10 节）。复制成仓库根目录的 .env 后由本人填写；.env 不进版本库。
# 这里只列变量名，不写值。

# 模型提供方与模型名（P1.5 / P3 定）。AGENT_PROVIDER 取 openai_compat（OpenAI 兼容接口：中转站、本地 Ollama）或 anthropic
AGENT_PROVIDER=
AGENT_MODEL=
# openai_compat 的接口地址，一般以 /v1 结尾（本地 Ollama 是 http://localhost:11434/v1）
AGENT_BASE_URL=

# 各家密钥（只填用到的）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 本地 OpenAI 兼容接口（如 Ollama）
LOCAL_BASE_URL=

# 额度（金额，P3 / P6 定）：个人一档（命令行 / MCP）、每人每日、全站每日、全站每月、全站并发
AGENT_BUDGET_PERSONAL_DAILY=
AGENT_BUDGET_USER_DAILY=
AGENT_BUDGET_SITE_DAILY=
AGENT_BUDGET_SITE_MONTHLY=
AGENT_MAX_CONCURRENCY=

# 对话服务（P6）：Next.js 转发给 agent.serve 时带的服务令牌；站点地址（CSRF 校验 Origin）
AGENT_SERVICE_TOKEN=
SITE_URL=

# Agent 工具层读的库路径（P1，可不填）：不填时用仓库根目录的 football.db、reports/latest_round.json、fotmob.db；相对路径按仓库根目录
AGENT_DB_PATH=
AGENT_SNAPSHOT_PATH=
AGENT_FOTMOB_PATH=

# 向量知识库（P2，可不填）：不填时 Milvus Lite 数据目录用 agent_data/kb，向量模型用 checkpoints/bge-m3（下载方式见 docs/stack.md）；相对路径按仓库根目录
AGENT_KB_PATH=
AGENT_EMBED_MODEL=
